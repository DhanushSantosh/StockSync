digraph G {
 graph [rankdir=TB, bgcolor=white, nodesep=0.34, ranksep=0.45, pad=0.12];
 node [shape=box, style=rounded, color=black, fontname="Times New Roman", fontsize=13, margin="0.14,0.08"];
 edge [color=black, arrowsize=0.7];
 hosting [label="Firebase Hosting"];
 client [label="React / TypeScript\nweb app"];
 auth [label="Firebase\nAuthentication"];
 sdk [label="Firestore SDK"];
 rules [label="Security Rules"];
 db [label="Cloud Firestore"];
 products [label="Products"];
 movements [label="Stock movements"];
 credit [label="Customer credit"];
 hosting -> client [label="serves"];
 client -> auth [label="sign in"];
 client -> sdk [label="read / write"];
 sdk -> rules -> db;
